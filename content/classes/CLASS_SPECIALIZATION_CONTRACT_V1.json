{
  "schema_version": "1.2.0",
  "purpose": "Canonical contract for all current and future ETRANOM class specializations",
  "required_shared_systems": [
    "stable_id",
    "damage_archetype",
    "attribute_profile",
    "skills",
    "skill_upgrades",
    "talent_trees",
    "domain",
    "ascensions",
    "resource_rules",
    "cooldowns",
    "status_effects",
    "summons",
    "combat_adapters",
    "progression",
    "save_schema",
    "ui_metadata"
  ],
  "combat_modes": [
    "solo",
    "party",
    "pvp"
  ],
  "damage_archetypes": [
    "physical",
    "magical",
    "hybrid",
    "eldritch"
  ],
  "attribute_keys": [
    "power",
    "speed",
    "endurance",
    "vitality",
    "intellect",
    "perception",
    "luck",
    "faith"
  ],
  "skill_definition": {
    "required": [
      "id",
      "name_fa",
      "type",
      "target",
      "unlock_level",
      "resource_type",
      "resource_cost",
      "cooldown_turns",
      "effects",
      "upgrades"
    ],
    "effect_fields": [
      "kind",
      "base",
      "percent",
      "flat",
      "chance_pct",
      "duration_turns",
      "target_count",
      "stack_rule",
      "refresh_rule",
      "pvp_policy"
    ]
  },
  "talent_tree": {
    "branches": 4,
    "nodes_per_branch": 8,
    "requires_prerequisite_validation": true
  },
  "domain": {
    "stages": 4,
    "must_define": [
      "unlock_level",
      "activation_cost",
      "duration",
      "cooldown",
      "stage_effects",
      "mode_rules"
    ]
  },
  "ascensions": {
    "options": 10,
    "selection_limit_per_domain_activation": 1,
    "must_be_mutually_exclusive": true
  },
  "resource_rules": {
    "must_define": [
      "primary_resource",
      "secondary_resource",
      "cost_timing",
      "refund_policy",
      "out_of_resource_behavior"
    ],
    "shared_defaults": {
      "cast_commit": "after_validation_before_effect",
      "out_of_resource": "reject_cast_without_resource_debit",
      "cooldown_unit": "player_turns",
      "cooldown_starts": "successful_cast"
    }
  },
  "status_effect_rules": {
    "must_define": [
      "stacking",
      "refresh",
      "duration",
      "tick_order",
      "cleanse_policy",
      "death_cleanup"
    ],
    "shared_defaults": {
      "stacking": "refresh_same_effect_key_unless_effect_declares_stack",
      "tick_order": [
        "dot_tick",
        "duration_decrement",
        "expiry_cleanup"
      ],
      "death_cleanup": "remove_temporary_combat_effects"
    }
  },
  "future_compatibility": {
    "new_class_slots": 8,
    "specializations_per_new_class": 4,
    "new_specialization_slots": 32
  },
  "shared_numeric_rules": {
    "stat_core": "systems/combat/character-stat-core.js",
    "physical": {
      "power_attack_per_point": 2.2,
      "power_skill_power_per_point": 2.8,
      "base_attack_included": true
    },
    "magical": {
      "intellect_attack_per_point": 5,
      "intellect_max_mana_per_point": 8
    },
    "eldritch": {
      "scaling_attribute": "intellect",
      "attack_per_point": 5,
      "same_damage_pipeline_as_magical": true
    },
    "hybrid": {
      "default_ratio": {
        "physical": 0.5,
        "magical": 0.5
      },
      "ratio_must_be_server_defined": true
    },
    "secondary_attributes": {
      "speed": {
        "evasion_pct_per_point_above_10": 0.35,
        "cap_pct": 45
      },
      "endurance": {
        "damage_reduction_pct_per_point_above_10": 0.3,
        "cap_pct": 60
      },
      "vitality": {
        "max_hp_per_point": 10
      },
      "perception": {
        "magical_accuracy_pct_per_point": 0.3,
        "critical_pct_per_point": 0.08
      },
      "luck": {
        "critical_pct_per_point": 0.15
      },
      "faith": {
        "max_mana_per_point": 4,
        "faith_archetype_max_mana_per_point": 8,
        "magic_resistance_pct_per_point": 0.2,
        "healing_pct_per_point": 0.2
      }
    },
    "caps": {
      "critical_chance_pct": 55,
      "magic_resistance_pct": 30,
      "healing_bonus_pct": 35,
      "evasion_pct": 45,
      "damage_reduction_pct": 60
    },
    "skill_effect_resolution": {
      "order": [
        "base_value",
        "rank_multiplier",
        "additive_percent_bonuses",
        "flat_bonus",
        "target_defense_and_resistance",
        "mode_tuning",
        "final_floor"
      ],
      "chance_range_pct": [
        0,
        100
      ],
      "duration_min_turns": 0,
      "cooldown_min_turns": 0,
      "resource_cost_min": 0
    },
    "compatibility": "Legacy actors keep their existing precomputed attack unless they explicitly opt into useCanonicalStatCore; all new class/specialization implementations must opt in.",
    "stat_core_version": "1.2.0",
    "skill_damage_formula": {
      "formula": "floor((attack_power * damage_pct / 100 * (1 + additive_bonus_pct / 100) + flat_bonus) * 100 / (100 + effective_defense * 1.25) * (1 - target_damage_reduction_pct / 100))",
      "defense_penetration_cap_pct": 80,
      "damage_pct_range": [
        0,
        10000
      ],
      "additive_bonus_pct_range": [
        -90,
        500
      ],
      "minimum_damage": 1,
      "damage_helper": "resolveCanonicalSkillDamage",
      "applies_to": [
        "physical",
        "magical",
        "eldritch",
        "hybrid"
      ],
      "target_damage_reduction_cap_pct": 90
    }
  },
  "implementation_requirements": {
    "must_use_shared_stat_core": true,
    "must_use_shared_skill_effect_contract": true,
    "no_specialization_may_override_base_stat_coefficients": true,
    "specialization_specific_modifiers_must_be_explicit_and_additive": true,
    "mode_specific_differences_must_be_server_owned": true,
    "canonical_stat_opt_in_required_for_current_specializations": true,
    "shared_damage_helper_required_for_all_specializations": true
  }
}
