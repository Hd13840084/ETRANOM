{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "etranom://safe-zone/module-v1",
  "title": "ETRANOM Safe Zone Module",
  "type": "object",
  "required": ["id", "type", "version", "entries"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "type": {"enum": ["npc_profiles", "dialogue_trees", "buildings", "services", "item_catalogs", "material_catalogs", "vendor_catalogs", "quest_catalogs", "recipe_catalogs", "crafting_stations", "reward_tables", "schedules", "reputation_rules", "travel_routes", "interiors", "city_events", "tutorials"]},
    "version": {"type": "string"},
    "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entries": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}}, "additionalProperties": true}},
    "enabled": {"type": "boolean", "default": false}
  },
  "additionalProperties": false
}
